{
  "manifest_version": 3,
  "name": "GitHub Actions Log Copy",
  "version": "1.1.0",
  "description": "Copy GitHub Actions step logs with one click.",
  "homepage_url": "https://oliverio.dev/projects/github-actions-log-copy/",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://github.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-actions-log-copy@oliverio.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/actions/runs/*/job/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
